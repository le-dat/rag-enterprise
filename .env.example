# ── LLM APIs ──────────────────────────────────────────────
OPENAI_API_KEY=

# ── Parsing ───────────────────────────────────────────────
LLAMAPARSE_API_KEY=
# Set to "false" to fallback to PyMuPDF (when LlamaParse credits run out)
USE_LLAMAPARSE=true

# ── Vector DB ─────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_enterprise

# ── Reranker ──────────────────────────────────────────────
COHERE_API_KEY=

# ── Retrieval Rail ────────────────────────────────────────
# Llama Guard via Groq (free tier: 14,400 req/day)
GROQ_API_KEY=

# ── Auth (JWT signing secret — fake for demo) ─────────────
JWT_SECRET=super-secret-dev-key-change-in-prod
JWT_ALGORITHM=HS256

# ── Deprecated / v2 only ──────────────────────────────────
# NEO4J_PASSWORD=   ← GraphRAG, out of scope for v1