# ── LLM APIs ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COHERE_API_KEY=
COHERE_MODEL=rerank-v3.5

# ── MiniMax Config ────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# ── Fallback Configuration ────────────────────────────────
LLM_FALLBACK_ORDER=openai,minimax

# ── Parsing ───────────────────────────────────────────────
LLAMAPARSE_API_KEY=
# Set to "false" to fallback to PyMuPDF (when LlamaParse credits run out)
USE_LLAMAPARSE=true

# ── Vector DB ─────────────────────────────────────────────
# TODO: Fill in from Qdrant Cloud dashboard → https://cloud.qdrant.io
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_enterprise

# ── Retrieval Rail ────────────────────────────────────────
# Llama Guard via Groq (free tier: 14,400 req/day)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-prompt-guard-2-86m

# ── Auth (fake JWT for demo) ──────────────────────────────
JWT_SECRET=super-secret-dev-key-change-in-prod
JWT_ALGORITHM=HS256

# ── Deprecated / v2 only ──────────────────────────────────
NEO4J_PASSWORD=password123456